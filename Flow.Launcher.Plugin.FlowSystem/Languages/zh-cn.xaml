<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <system:String x:Key="flowlauncher_plugin_flowsystem_plugin_description">Flow Launcher 系统信息插件</system:String>
    <system:String x:Key="flowlauncher_plugin_flowsystem_reload">重新加载系统信息</system:String>
    <system:String x:Key="flowlauncher_plugin_flowsystem_reload_description">重新读取硬件和系统信息</system:String>
    <system:String x:Key="flowlauncher_plugin_flowsystem_reload_success">系统信息已更新。</system:String>

    <system:String x:Key="flowlauncher_plugin_flowsystem_copy">复制系统概览</system:String>
    <system:String x:Key="flowlauncher_plugin_flowsystem_copy_description">以纯文本形式复制所有硬件和系统信息</system:String>

    <system:String x:Key="flowlauncher_plugin_flowsystem_processor">处理器</system:String>
    <system:String x:Key="flowlauncher_plugin_flowsystem_core">核</system:String>
    <system:String x:Key="flowlauncher_plugin_flowsystem_cores">核</system:String>
    <system:String x:Key="flowlauncher_plugin_flowsystem_thread">线程</system:String>
    <system:String x:Key="flowlauncher_plugin_flowsystem_threads">线程</system:String>
    <system:String x:Key="flowlauncher_plugin_flowsystem_graphics_card">显卡</system:String>
    <system:String x:Key="flowlauncher_plugin_flowsystem_installed_memory">已安装内存</system:String>
    <system:String x:Key="flowlauncher_plugin_flowsystem_memory_module">个内存模块</system:String>
    <system:String x:Key="flowlauncher_plugin_flowsystem_memory_modules">个内存模块</system:String>
    <system:String x:Key="flowlauncher_plugin_flowsystem_network_adapter">网络适配器</system:String>
    <system:String x:Key="flowlauncher_plugin_flowsystem_wireless_lan">Wi-Fi</system:String>
    <system:String x:Key="flowlauncher_plugin_flowsystem_ethernet">以太网</system:String>
    <system:String x:Key="flowlauncher_plugin_flowsystem_network_unknown">未知网络适配器</system:String>
    <system:String x:Key="flowlauncher_plugin_flowsystem_network_query_failed">无法查询网络适配器</system:String>
    <system:String x:Key="flowlauncher_plugin_flowsystem_storage_device">存储设备</system:String>
    <system:String x:Key="flowlauncher_plugin_flowsystem_storage_query_failed">无法查询存储设备</system:String>
    <system:String x:Key="flowlauncher_plugin_flowsystem_operating_system">操作系统</system:String>
    <system:String x:Key="flowlauncher_plugin_flowsystem_build">内部版本</system:String>
    <system:String x:Key="flowlauncher_plugin_flowsystem_system_architecture">系统架构</system:String>

    <system:String x:Key="flowlauncher_plugin_flowsystem_device_security">设备安全</system:String>
    <system:String x:Key="flowlauncher_plugin_flowsystem_secure_boot_enabled">已启用安全启动</system:String>
    <system:String x:Key="flowlauncher_plugin_flowsystem_secure_boot_disabled">已禁用安全启动</system:String>
    <system:String x:Key="flowlauncher_plugin_flowsystem_secure_boot_unreadable">无法获取安全启动状态</system:String>
    <system:String x:Key="flowlauncher_plugin_flowsystem_tpm_not_detected">未检测到 TPM</system:String>
    <system:String x:Key="flowlauncher_plugin_flowsystem_tpm_version_unavailable">无法获取 TPM 版本</system:String>

    <system:String x:Key="flowlauncher_plugin_flowsystem_cpu_unknown">未知处理器</system:String>
    <system:String x:Key="flowlauncher_plugin_flowsystem_os_unknown">未知操作系统</system:String>
    <system:String x:Key="flowlauncher_plugin_flowsystem_os_query_failed">无法查询操作系统</system:String>
    <system:String x:Key="flowlauncher_plugin_flowsystem_gpu_unknown">未知显卡</system:String>
    <system:String x:Key="flowlauncher_plugin_flowsystem_gpu_query_failed">无法查询显卡</system:String>
    <system:String x:Key="flowlauncher_plugin_flowsystem_ram_unknown">未知内存</system:String>
    <system:String x:Key="flowlauncher_plugin_flowsystem_ram_query_failed">无法查询内存</system:String>
